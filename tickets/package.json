{
  "name": "tickets",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "ts-node-dev --poll src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --no-cache",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./src/test/setup.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "/nats-wrapper\\.js$": "<rootDir>/src/__mocks__/nats-wrapper.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bgticketz/common": "^1.0.21",
    "@types/mongoose": "^5.11.96",
    "cookie-session": "^2.1.1",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "mongoose-update-if-current": "^1.4.0",
    "node-nats-streaming": "^0.3.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@types/express": "4.17.21"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "mongodb-memory-server@11.2.0": true
  }
}
